# Salin ke .env di folder proyek. JANGAN pernah commit .env.
# Semua variabel backend memakai prefiks PLI_.
PLI_ENVIRONMENT=development
PLI_DEBUG=true
PLI_DATABASE_URL=sqlite:///./data/pli.db
PLI_SECRET_KEY=ganti-dengan-nilai-acak-panjang-minimal-32-karakter
# Fase 6 - kunci lama hanya untuk verify sesi selama masa transisi rotasi.
# Dikelola otomatis oleh endpoint rotasi; jangan diisi manual.
PLI_SECRET_KEY_PREVIOUS=
PLI_SESSION_TTL_HOURS=12
PLI_COOKIE_SECURE=false
PLI_COOKIE_SAMESITE=lax
PLI_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PLI_MAX_UPLOAD_MB=25
PLI_DEMO_MODE=true

# Fase 3 - default parameter BKT. Administrator dapat mengubah nilai ini saat
# runtime melalui halaman "Mesin Intelijen"; perubahan tersimpan di database
# dan tercatat di log audit. p_slip + p_guess harus < 1.
PLI_BKT_P_INIT=0.20
PLI_BKT_P_TRANSIT=0.25
PLI_BKT_P_SLIP=0.10
PLI_BKT_P_GUESS=0.20
PLI_BKT_MASTERY_THRESHOLD=0.80

# Fase 4 - kunci API HANYA di server/backend, tidak pernah di frontend.
# Nama variabel yang dipakai adapter disimpan di tabel ai_providers (kolom api_key_env).
# PLI_AI_GEMINI_API_KEY=
# PLI_AI_GROQ_API_KEY=
# PLI_AI_OPENROUTER_API_KEY=
# PLI_AI_HUGGINGFACE_API_KEY=
# PLI_AI_CEREBRAS_API_KEY=
# PLI_AI_MISTRAL_API_KEY=
# PLI_AI_OPENAI_API_KEY=

# Fase 4 - batas penggunaan awal. Administrator dapat mengubahnya saat runtime
# lewat Menu AI → Penyedia; perubahan tersimpan di engine_configs dan log audit.
PLI_AI_REQUEST_TIMEOUT_SEC=30
PLI_AI_MAX_TOKENS_PER_REQUEST=1024
PLI_AI_DAILY_TOKEN_LIMIT=50000
PLI_AI_MONTHLY_COST_LIMIT_USD=0

# Fase 4 - pengaturan RAG dan tutor (dapat disesuaikan dengan kebutuhan sekolah).
PLI_RAG_CHUNK_SIZE=900
PLI_RAG_CHUNK_OVERLAP=150
PLI_RAG_TOP_K=4
PLI_TUTOR_MAX_HISTORY=12

# Fase 6 - produksi, backup terenkripsi, retensi, dan monitoring.
# Kunci backup HARUS berbeda dari PLI_SECRET_KEY dan hanya ada di server.
# Hasil generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PLI_BACKUP_ENCRYPTION_KEY=
PLI_RETENTION_DAYS=365
PLI_AI_LOG_RETENTION_DAYS=90
PLI_AUDIT_LOG_RETENTION_DAYS=365
PLI_METRICS_ENABLED=true
# Untuk PostgreSQL produksi, ganti baris database di atas, misalnya:
# PLI_DATABASE_URL=postgresql+psycopg2://pli:PASSWORD@127.0.0.1:5432/pli
# PLI_ENVIRONMENT=production
# PLI_DEBUG=false
# PLI_COOKIE_SECURE=true
